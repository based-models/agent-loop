# Read by the CLI only. The library never reads this file.

# One of: anthropic | openrouter | modal | openai
LLM_PROVIDER=openrouter

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

MODAL_ENDPOINT_URL=
MODAL_ENDPOINT_MODEL=Qwen/Qwen3.6-35B-A3B-FP8
MODAL_PROXY_TOKEN_ID=
MODAL_PROXY_TOKEN_SECRET=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.1

# Optional: tracing. The application configures OTel, not the library.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
